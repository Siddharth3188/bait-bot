# Required: create an application and bot in the Discord Developer Portal.
DISCORD_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_discord_application_client_id

# Recommended for instant command updates in one test server.
DISCORD_GUILD_ID=your_test_server_id

# Optional: without this, Bait Bot uses its built-in joke templates.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 0 = templates only, 1 = AI whenever configured, 0.5 = hybrid (default)
AI_JOKE_CHANCE=0.5
